---
import Base from '../../layouts/Base.astro';
import ChatDemo from '../../components/ChatDemo.astro';
import { services } from '../../data/services';
import { site, waLink } from '../../data/site';

export function getStaticPaths() {
  return services.map((s) => ({ params: { slug: s.slug }, props: { s } }));
}
const { s } = Astro.props;
const usd = (n: number) => n.toLocaleString('es-CO');
const base = Astro.site!.href.replace(/\/$/, '');
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: s.name,
    description: s.description,
    serviceType: s.name,
    areaServed: 'CO',
    provider: { '@type': 'ProfessionalService', name: `${site.brand} · ${site.name}`, url: base },
    offers: { '@type': 'AggregateOffer', priceCurrency: 'USD', lowPrice: s.from, highPrice: s.to },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: s.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${base}/` },
      { '@type': 'ListItem', position: 2, name: s.name, item: `${base}/servicios/${s.slug}/` },
    ],
  },
];
---
<Base title={s.title} description={s.description} schema={schema}>
  <section class="hero hero-dark">
    <div class="wrap svc">
      <p class="crumb ui"><a href="/">Inicio</a> / {s.name}</p>
      <h1>{s.h1}</h1>
      <p class="lede">{s.intro}</p>
      <div class="hero-cta">
        <a class="btn btn-gold" href={waLink(s.wa)} data-track="wa_service">Cotizar por WhatsApp</a>
        <a class="btn btn-ghost" href="/#cotizador">Usar el cotizador</a>
      </div>
      <p class="who ui">Desde USD {usd(s.from)} · {s.timeline}</p>
    </div>
  </section>

  {s.slug === 'asistente-whatsapp-ia' && (
    <section>
      <div class="wrap"><ChatDemo /></div>
    </section>
  )}

  <section class="sec-alt">
    <div class="wrap about">
      <div>
        <h2>Para quién es</h2>
        <ul class="plain">{s.forWho.map((x) => <li>{x}</li>)}</ul>
      </div>
      <div>
        <h2>Qué incluye</h2>
        <ul class="plain">{s.includes.map((x) => <li>{x}</li>)}</ul>
      </div>
    </div>
  </section>

  {s.proof.length > 0 && (
    <section>
      <div class="wrap">
        <h2>Trabajo que puedes revisar</h2>
        <ul class="plain">{s.proof.map((p) => <li><a href={p.href} rel="noopener">{p.label}</a></li>)}</ul>
      </div>
    </section>
  )}

  <section class="sec-alt">
    <div class="wrap">
      <h2>Preguntas frecuentes</h2>
      <div class="faq">
        {s.faq.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
      </div>
    </div>
  </section>

  <section class="cta-final">
    <div class="wrap">
      <h2>¿Lo hablamos?</h2>
      <p class="lede">La primera conversación y el diagnóstico no tienen costo.</p>
      <div class="hero-cta">
        <a class="btn btn-gold" href={waLink(s.wa)} data-track="wa_service_final">Escribirme por WhatsApp</a>
      </div>
    </div>
  </section>
</Base>
