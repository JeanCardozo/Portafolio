---
import '@fontsource-variable/newsreader';
import '@fontsource-variable/schibsted-grotesk';
import '../styles/global.css';
import { site, waLink } from '../data/site';

interface Props { title: string; description: string; schema?: object[]; noindex?: boolean; }
const { title, description, schema = [], noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="es-CO">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#121212" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:site_name" content={`${site.name} · ${site.brand}`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og.png', Astro.site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="JeanCRG: sitios web que traen clientes por WhatsApp" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="robots" content={noindex ? 'noindex' : 'index,follow,max-image-preview:large'} />
    {import.meta.env.PUBLIC_GSC_VERIFICATION && <meta name="google-site-verification" content={import.meta.env.PUBLIC_GSC_VERIFICATION} />}
    {schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body>
    <a class="skip" href="#contenido">Saltar al contenido</a>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/" aria-label={`${site.brand}, inicio`}>
          <img src="/logo-mark.png" alt="" width="44" height="44" />
          {site.brand}
        </a>
        <nav class="nav" aria-label="Principal">
          <a href="/#servicios">Servicios</a>
          <a href="/guias/">Guías</a>
          <a href="/#casos">Casos</a>
          <a href="/#dudas">Dudas</a>
          <a href="/#sobre-mi">Sobre mí</a>
        </nav>
        <a class="btn btn-ghost" style="padding:.6rem 1rem" href={waLink('Hola Jean, vi tu portafolio y quiero cotizar.')} data-track="wa_header">WhatsApp</a>
      </div>
    </header>
    <main id="contenido"><slot /></main>
    <a class="stick-cta ui" href={waLink('Hola Jean, vi tu portafolio y quiero cotizar.')} data-track="wa_sticky">Cotizar por WhatsApp</a>
    <footer class="site-footer">
      <div class="wrap">
        <nav class="foot-links ui" aria-label="Servicios">
          <a href="/servicios/paginas-web-ibague/">Páginas web en Ibagué</a>
          <a href="/servicios/tiendas-en-linea-colombia/">Tiendas en línea</a>
          <a href="/servicios/asistente-whatsapp-ia/">Asistente de WhatsApp con IA</a>
          <a href="/servicios/software-a-la-medida/">Software a la medida</a>
          <a href="/guias/">Guías</a>
          <a href="/como-trabajo/">Cómo trabajo</a>
          <a href="/casos/tecnicenter/">Caso Tecni Center</a>
          <a href="/casos/la-tertulia/">Caso La Tertulia</a>
        </nav>
        <span>© {year} {site.name} · {site.city}</span>
        <nav class="foot-links ui" aria-label="Legal">
          <a href="/privacidad/">Tratamiento de datos</a>
          <a href="/terminos/">Términos y condiciones</a>
          <a href="/cookies/">Cookies</a>
        </nav>
        <span>
          <a href={site.linkedin} rel="me noopener">LinkedIn</a> ·
          <a href={site.github} rel="me noopener">GitHub</a> ·
          <a href={site.youtube} rel="me noopener">YouTube</a> ·
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </span>
      </div>
    </footer>
  </body>
</html>
